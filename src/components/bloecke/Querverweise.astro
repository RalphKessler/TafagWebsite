---
import { markenLogo, type Marke } from '../../lib/marke';
interface Props { titel?: string; text?: string; eintraege: { titel: string; text?: string; link?: string; bild?: string; marke: Marke }[] }
const { titel, text, eintraege } = Astro.props;
// Hat ein Eintrag ein Bild, bekommen alle eine Bildfläche – so bleiben die Karten gleich hoch
const mitBild = eintraege.some((e) => e.bild);
---

<div class="querverweise">
  {(titel || text) && (
    <div class="kopf">
      {titel && <h2>{titel}</h2>}
      {text && <p class="lead">{text}</p>}
    </div>
  )}
  <ul style={`--anzahl:${Math.min(eintraege.length, 4)}`}>
    {
      eintraege.map((e) => {
        const logo = markenLogo[e.marke];
        return (
          <li data-marke={e.marke} class:list={{ 'mit-bild': mitBild }}>
            {mitBild && <div class="foto">{e.bild && <img src={e.bild} alt="" width="640" height="400" loading="lazy" decoding="async" />}</div>}
            <div class="oben">
              <h3>{e.link ? <a href={e.link}>{e.titel}</a> : e.titel}</h3>
              {logo && <img src={logo.src} alt="" width={logo.breite} height={logo.hoehe} loading="lazy" />}
            </div>
            {e.text && <p>{e.text}</p>}
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .kopf { max-width: 48rem; margin-bottom: 2.25rem; }
  .kopf .lead { margin: 0; color: inherit; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--anzahl), 1fr); gap: 1.25rem; }
  li { position: relative; background: var(--weiss); color: var(--text); border-radius: 16px; padding: 1.5rem; border-top: 6px solid var(--akzent); }
  li:hover { box-shadow: 0 0 0 2px var(--akzent); }
  .oben { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  h3 { font-size: 1.25rem; margin: 0 0 .5rem; color: var(--text) !important; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  li:has(a:focus-visible) { outline: 3px solid var(--tafag-gelb); outline-offset: 3px; }
  h3 a:focus-visible { outline: none; }
  .oben img { height: 2.2rem; width: auto; }
  li.mit-bild { overflow: hidden; }
  .foto { margin: -1.5rem -1.5rem 1.25rem; aspect-ratio: 16 / 10; background: var(--grau-100); }
  .foto img { width: 100%; height: 100%; object-fit: cover; }
  p { margin: 0; color: var(--text-2); font-size: .98rem; }
  @media (max-width: 900px) { ul { grid-template-columns: 1fr; } }
</style>
