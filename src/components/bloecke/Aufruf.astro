---
import Gleis from '../Gleis.astro';
interface Props { titel: string; text?: string; beschriftung: string; link: string; beschriftung2?: string; link2?: string }
const { titel, text, beschriftung, link, beschriftung2, link2 } = Astro.props;
---

<div class="aufruf dunkel">
  <Gleis class="gleis" schwellen="rgb(255 255 255 / .35)" />
  <div class="inhalt">
    <h2>{titel}</h2>
    {text && <p>{text}</p>}
  </div>
  <p class="aktionen">
    <a class="knopf gelb" href={link}>{beschriftung}</a>
    {beschriftung2 && link2 && <a class="knopf hell" href={link2}>{beschriftung2}</a>}
  </p>
</div>

<style>
  .aufruf { position: relative; overflow: hidden; background: var(--akzent); color: rgb(255 255 255 / .9); border-radius: 22px; padding: clamp(2rem, 5vw, 3.5rem); display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .aufruf :global(.gleis) { position: absolute; left: 0; bottom: 0; width: 100%; height: 2.5rem; opacity: .5; }
  .inhalt, .aktionen { position: relative; }
  .inhalt { max-width: 40rem; }
  h2 { color: var(--weiss); margin-bottom: .4rem; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .inhalt p { margin: 0; }
  .aktionen { display: flex; flex-wrap: wrap; gap: .75rem; margin: 0; }
</style>
