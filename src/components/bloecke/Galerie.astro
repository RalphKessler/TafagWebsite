---
interface Props { titel?: string; bilder: { bild: string; alt?: string; legende?: string }[] }
const { titel, bilder } = Astro.props;
---

<section class="galerie">
  {titel && <h2>{titel}</h2>}
  <ul class="raster">
    {
      bilder.map((b) => (
        <li>
          <a href={b.bild} data-legende={b.legende ?? ''}>
            <img src={b.bild} alt={b.alt ?? b.legende ?? ''} loading="lazy" decoding="async" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Einfache Bildvergrösserung (Lightbox) – das Fenster entsteht per JavaScript,
  // darum sind die Stile unten mit :global() geschrieben.
  let dialog: HTMLDialogElement | null = null;
  function oeffnen(src: string, legende: string, alt: string) {
    if (!dialog) {
      dialog = document.createElement('dialog');
      dialog.className = 'lightbox';
      dialog.innerHTML =
        '<button class="lightbox-zu" aria-label="Schliessen">×</button><img alt=""><p></p>';
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog || (e.target as HTMLElement).closest('.lightbox-zu')) dialog?.close();
      });
      document.body.append(dialog);
    }
    const img = dialog.querySelector('img')!;
    img.src = src;
    img.alt = alt;
    dialog.querySelector('p')!.textContent = legende;
    dialog.showModal();
  }
  document.querySelectorAll<HTMLAnchorElement>('.galerie .raster a').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      oeffnen(a.href, a.dataset.legende ?? '', a.querySelector('img')?.alt ?? '');
    });
  });
</script>

<style>
  .raster { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: .75rem; }
  .raster img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; border-radius: var(--radius); }
  :global(.lightbox) { border: 0; padding: 0; background: transparent; max-width: 95vw; max-height: 95vh; }
  :global(.lightbox::backdrop) { background: rgb(0 0 0 / .85); }
  :global(.lightbox img) { max-width: 95vw; max-height: 85vh; margin: auto; }
  :global(.lightbox p) { color: #fff; text-align: center; margin: .5rem 0 0; }
  :global(.lightbox-zu) { position: fixed; top: 1rem; right: 1rem; font-size: 2rem; line-height: 1; background: #fff; border: 0; border-radius: 50%; width: 2.8rem; height: 2.8rem; cursor: pointer; }
</style>
