---
import daten from '../../data/bereiche.json';
import { t, type Sprache } from '../../i18n';

interface Props { sprache: Sprache }
const { sprache } = Astro.props;
---

<section class="abschnitt grau" id="bereiche">
  <div class="breite">
    <div class="kopf">
      <h2>{t(sprache, 'startBereicheTitel')}</h2>
      <p class="lead">{t(sprache, 'startBereicheText')}</p>
    </div>
    <ul class="liste">
      {
        daten.bereiche.map((b) => {
          return (
            <li class="bereich">
              {'bild' in b && b.bild && <img class="foto" src={b.bild} alt="" width="640" height="400" loading="lazy" decoding="async" />}
              <div class="oben">
                <h3><a href={b.link}>{b.titel}</a></h3>
              </div>
              <p>{b.text}</p>
              <ul class="punkte">
                {b.punkte.map((p) => <li><a href={p.link}>{p.titel}</a></li>)}
              </ul>
              <a class="mehr" href={b.link} aria-label={t(sprache, 'mehrZu', { titel: b.titel })}>{t(sprache, 'mehrZu', { titel: b.titel })}</a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .kopf { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .kopf h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); }
  .kopf .lead { margin: 0; }
  .liste { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .bereich {
    position: relative; display: flex; flex-direction: column; background: var(--weiss); border-radius: 16px; overflow: hidden;
    padding: 1.75rem 1.5rem 1.5rem; border: 1px solid var(--grau-100); border-top: 6px solid var(--akzent);
  }
  .foto { margin: -1.75rem -1.5rem 1.5rem; width: calc(100% + 3rem); max-width: none; aspect-ratio: 16 / 10; object-fit: cover; }
  .bereich:hover { border-color: var(--grau-200); border-top-color: var(--akzent); }
  .oben { display: flex; justify-content: space-between; align-items: flex-start; gap: .75rem; min-height: 3.2rem; }
  h3 { font-size: 1.45rem; margin: 0; }
  h3 a { color: var(--text); text-decoration: none; }
  .oben img { height: 2.6rem; width: auto; }
  .bereich > p { color: var(--text-2); font-size: .98rem; margin: 1rem 0 1.25rem; }
  .punkte { list-style: none; margin: 0 0 1.5rem; padding: 0; border-top: 1px solid var(--grau-100); }
  .punkte li { border-bottom: 1px solid var(--grau-100); }
  .punkte a { display: block; padding: .55rem 0; color: var(--text); text-decoration: none; font-weight: 600; font-size: .95rem; }
  .punkte a:hover { color: var(--akzent-text); }
  .mehr { margin-top: auto; font-weight: 700; color: var(--akzent-text); }
  @media (max-width: 1100px) { .liste { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .kopf { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .liste { grid-template-columns: 1fr; } }
</style>
