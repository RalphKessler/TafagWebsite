---
import Gleis from '../Gleis.astro';
import { zeigeTodo } from '../../lib/hilfen';
import { t, type Sprache } from '../../i18n';

interface Props { titel: string; einleitung?: string; bild?: string; bildAlt?: string; sprache: Sprache }
const { titel, einleitung, bild, bildAlt, sprache } = Astro.props;
---

<section class="hero dunkel">
  <Gleis class="gleis" />
  <div class:list={["breite innen", { "ohne-bild": !bild && !zeigeTodo }]}>
    <div class="text">
      <h1>{titel}</h1>
      {einleitung && <p class="lead">{einleitung}</p>}
      <p class="aktionen">
        <a class="knopf gelb" href="#bereiche">{t(sprache, 'startBereicheTitel')}</a>
        <a class="knopf hell" href={`/${sprache}/kontakt/`}>{t(sprache, 'kontaktAufnehmen')}</a>
      </p>
    </div>
    {(bild || zeigeTodo) && <figure class="bild">
      {
        bild ? (
          <img src={bild} alt={bildAlt ?? ''} width="900" height="1100" />
        ) : (
          <div class="platzhalter">
            <span>Bild folgt</span>
          </div>
        )
      }
    </figure>}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: var(--navy); color: #d4dfeb; }
  .hero :global(.gleis) { position: absolute; left: 0; bottom: 0; width: 100%; height: clamp(2.25rem, 4vw, 3.25rem); opacity: .45; }
  .innen { position: relative; display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; padding-block: clamp(3.5rem, 8vw, 6rem) clamp(5rem, 9vw, 7rem); }
  .innen.ohne-bild { grid-template-columns: minmax(0, 52rem); }
  h1 { color: var(--weiss); font-size: clamp(2.4rem, 5.6vw, 4.4rem); }
  .lead { color: #c9d6e3; font-size: clamp(1.1rem, 1.7vw, 1.35rem); }
  .aktionen { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .bild { margin: 0; }
  .bild img, .platzhalter { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 20px; }
  .platzhalter { display: grid; place-items: end start; padding: 1.5rem; background: var(--navy-2); border: 1px dashed #4d6a86; }
  .platzhalter span { color: #9fb3c8; font-size: .85rem; font-weight: 600; }
  @media (max-width: 860px) {
    .innen { grid-template-columns: 1fr; }
    .bild img, .platzhalter { aspect-ratio: 16 / 10; }
  }
</style>
