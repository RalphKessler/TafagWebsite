---
// Die Startseite liegt unter /de/. Auf Hostpoint leitet .htaccess per 301 um;
// diese Seite ist nur der Rückfall (z. B. lokal).
import { noindex } from '../lib/hilfen';
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta http-equiv="refresh" content="0; url=/de/" />
    <link rel="canonical" href="/de/" />
    <title>Tafag AG</title>
  </head>
  <body><a href="/de/">Zur Website</a></body>
</html>
